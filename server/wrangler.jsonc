{
  "name": "sr-coop",
  "main": "src/index.ts",
  "compatibility_date": "2025-01-01",
  "durable_objects": {
    "bindings": [
      { "name": "DUNGEON_ROOMS", "class_name": "DungeonRoom" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["DungeonRoom"] }
  ],
  "vars": {
    // Firebase project id used to validate ID tokens (aud/iss) in DungeonRoom.
    // Fill it with your project id when deploying.
    "FIREBASE_PROJECT_ID": ""
  }
}
